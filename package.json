{
  "name": "navis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "boundaries": "depcruise packages --config dependency-cruiser.config.cjs",
    "build": "pnpm -r --if-present build",
    "dependencies:audit": "pnpm audit --prod --audit-level high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "openspec:validate": "openspec validate --all --strict",
    "test": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test && pnpm openspec:validate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.9.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
