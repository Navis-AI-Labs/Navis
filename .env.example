# Navis API configuration (service defaults).
# The service never reads this file; edit the environment or
# regenerate the entrypoint instead. Every key is documented in
# services/api/src/config.ts and validated at startup.

# API listen host (loopback only by default; expose via a reverse proxy)
# NAVIS_API_HOST=127.0.0.1

# API listen port
# NAVIS_API_PORT=8080

# Log verbosity: debug | info | warn | error
# NAVIS_API_LOG_LEVEL=info

# Comma-separated allowlist of request fields that survive log masking.
# Everything else is masked before the line is emitted.
# NAVIS_API_LOG_REDACTION_ALLOWLIST=method,path,status,duration_ms

# Maximum request body size in bytes (8 MiB default)
# NAVIS_API_MAX_BODY_BYTES=8388608

# Graceful shutdown budget in milliseconds (30 s default)
# NAVIS_API_SHUTDOWN_TIMEOUT_MS=30000

# Postgres connection string — required for services/* migrations + runtime.
# ci.yml uses postgres://navis:navis@127.0.0.1:5432/navis_test
# DATABASE_URL=postgres://navis:navis@127.0.0.1:5432/navis_test
