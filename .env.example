# The executable service requires PostgreSQL; Docker mounts its connection secret.
# Use `pnpm instance setup` to create private .local/runtime.env and secret files.
# Never place real credentials in this example or in a project declaration.

NAVIS_API_HOST=127.0.0.1
NAVIS_API_PORT=8080
NAVIS_API_LOG_LEVEL=info
NAVIS_API_MAX_BODY_BYTES=1048576
NAVIS_API_SHUTDOWN_TIMEOUT_MS=10000
NAVIS_API_MAX_LEDGER_BYTES=8388608

# Supply exactly one database source.
# DATABASE_URL_FILE=/run/navis/database-url
# DATABASE_URL=postgres://user:password@localhost:5432/database

# Model configuration is independent of Navis device authentication.
# NAVIS_MODEL_BASE_URL=https://provider.example/v1
# NAVIS_MODEL_NAME=model-name
# NAVIS_MODEL_API_KEY_FILE=/run/navis/model-key
NAVIS_MODEL_DAILY_LIMIT=100
NAVIS_MODEL_PENDING_LIMIT=32
