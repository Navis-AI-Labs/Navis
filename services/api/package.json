{
  "name": "@navis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Navis API service — a node:http adapter over public contracts.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.test.json --noEmit --pretty false",
    "start": "node dist/platform/index.js"
  },
  "dependencies": {
    "@navis/contracts": "workspace:*",
    "zod": "4.4.3",
    "@navis/application": "workspace:*",
    "@navis/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@navis/infrastructure": "workspace:*"
  }
}
