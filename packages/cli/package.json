{
  "name": "@navis/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Navis CLI for project commands, durable Bridge capture, synchronization and local instance connection.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "navis": "./dist/process/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.test.json --noEmit --pretty false"
  },
  "dependencies": {
    "@navis/bridge-daemon": "workspace:*",
    "@navis/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
